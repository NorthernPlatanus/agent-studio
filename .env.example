# CometAPI (OpenAI-compatible aggregator) — key for cheap worker models
COMETAPI_KEY=sk-...

# Optional: override the claude CLI binary (defaults to `claude` on PATH).
# Claude Code subscription auth is picked up automatically by the CLI.
# CLAUDE_BIN=claude

# Optional: override config values (ORCH_<SECTION>_<KEY>), e.g.
# ORCH_PROJECT_REPO_PATH=/absolute/path/to/your/repo
