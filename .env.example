# NOTE: nothing in orchestrator/ loads this file — providers read os.environ
# directly. Export it yourself before a run:  set -a; . ./.env; set +a
# Without that, a cash provider fails startup validation (or, before that check
# existed, burned every retry on 401s).

# OpenAI — the default worker tier (presets luna_high / luna_med / luna_xhigh,
# provider `openai`, type openai_responses). Required by the shipped profiles.
OPENAI_API_KEY=sk-...

# Anthropic Messages API — only needed if a preset binds to provider `anthropic`
# (type anthropic_api). The claude_cli presets do NOT use this: the CLI carries
# its own subscription auth.
# ANTHROPIC_API_KEY=sk-ant-...

# CometAPI (OpenAI-compatible aggregator) — only needed for the `deepseek_flash`
# preset and anything else bound to provider `cometapi`.
# COMETAPI_KEY=sk-...

# Optional: override the claude CLI binary (defaults to `claude` on PATH).
# Claude Code subscription auth is picked up automatically by the CLI.
# CLAUDE_BIN=claude

# Optional: override config values (ORCH_<SECTION>_<KEY>), e.g.
# ORCH_PROJECT_REPO_PATH=/absolute/path/to/your/repo
